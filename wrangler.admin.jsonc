{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saver-admin-local",
  "main": "src/admin.ts",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/admin",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "vars": {
    "ACCESS_ISSUER": "",
    "ACCESS_AUD": "",
    "ADMIN_EMAIL": "",
    "ADMIN_ORIGIN": "http://localhost:8788",
    "PUBLIC_ORIGIN": "http://localhost:8787",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "saver-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "PHOTOS",
      "id": "00000000000000000000000000000001",
    },
  ],
  "env": {
    "staging": {
      "name": "saver-admin-staging",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "ACCESS_ISSUER": "https://curly-silence-d3a6.cloudflareaccess.com",
        "ACCESS_AUD": "3a9b6e6b40a5624f0ffc0dfe2ce68461dbe58fe30e90d63fb44e6dbdfb624c67",
        "ADMIN_EMAIL": "wellington220100@gmail.com",
        "ADMIN_ORIGIN": "https://saver-admin-staging.fazcents.workers.dev",
        "PUBLIC_ORIGIN": "https://saver-public-staging.fazcents.workers.dev",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "saver-staging",
          "database_id": "7ba02fae-5a9f-4796-8405-79674cb861f4",
          "migrations_dir": "migrations",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "PHOTOS",
          "id": "ea9447d3a2e24c13bbfa1149aaacb8d4",
        },
      ],
    },
    "production": {
      "name": "saver-admin-production",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "admin.saverdoceria.com.br", "custom_domain": true },
      ],
      "vars": {
        "ACCESS_ISSUER": "https://curly-silence-d3a6.cloudflareaccess.com",
        "ACCESS_AUD": "b7facd9bf9fecce5d1816328e9eb04ddad2cb161cabceb7b0099006c575bc767",
        "ADMIN_EMAIL": "wellington220100@gmail.com",
        "ADMIN_ORIGIN": "https://admin.saverdoceria.com.br",
        "PUBLIC_ORIGIN": "https://saverdoceria.com.br",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "saver-production",
          "database_id": "d11d60df-0ba4-4168-9427-ded4ecf37b06",
          "migrations_dir": "migrations",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "PHOTOS",
          "id": "854c0e9ed68d486f9b8a93f08449714b",
        },
      ],
    },
  },
}
